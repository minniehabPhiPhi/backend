PORT=3000
# ใส่ DATABASE_URL บรรทัดเดียวแทน DB_* ได้ เช่น mysql://user:pass@host:port/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lunch_delivery
DB_CONNECTION_LIMIT=10
# true/false (ไม่ใส่ = เปิดอัตโนมัติเมื่อเป็น host ของ Aiven)
DB_SSL=
# เนื้อหา ca.pem จาก Aiven (ไม่บังคับ) ใส่ \n แทนการขึ้นบรรทัดใหม่ได้
DB_SSL_CA=
JWT_SECRET=replace-with-your-secret
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:5500,http://localhost:5500
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=67108864
